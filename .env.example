# Copy to .env.local and fill in. Nothing here is read at build time —
# missing values disable the corresponding feature at runtime instead.

# ---------------------------------------------------------------------------
# M-PESA (Safaricom Daraja) — domestic Kenyan payments
# Create an app at https://developer.safaricom.co.ke to get these.
# ---------------------------------------------------------------------------

# "sandbox" (default) or "production"
MPESA_ENV=sandbox

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Paybill or Till number. Sandbox test shortcode is 174379.
MPESA_SHORTCODE=174379

# Lipa Na M-PESA Online passkey from the Daraja portal.
MPESA_PASSKEY=

# --- Callback security ------------------------------------------------------
#
# Safaricom sends NO signature or shared secret with its callbacks, so the
# secret lives in the URL itself. Generate a long random value:
#
#     openssl rand -hex 32
#
# The callback route is /api/mpesa/callback/<MPESA_CALLBACK_TOKEN>, and
# MPESA_CALLBACK_URL must be that full path. Treat this token like a password:
# anyone who learns it can post fake payment confirmations.
MPESA_CALLBACK_TOKEN=

# Must be publicly reachable over HTTPS and include the token above, e.g.
# https://your-domain.com/api/mpesa/callback/<token>
# For local development use an ngrok/cloudflared tunnel.
MPESA_CALLBACK_URL=

# Optional second layer: comma-separated IPs permitted to POST callbacks.
# Leave blank to skip the check (the token still applies). Verify the current
# ranges against Safaricom's Daraja documentation before setting this — a wrong
# list silently drops real payments.
MPESA_CALLBACK_ALLOWED_IPS=

# ---------------------------------------------------------------------------
# Rate limiting and callback idempotency (Vercel KV / Upstash Redis)
# ---------------------------------------------------------------------------
#
# REQUIRED IN PRODUCTION. Without these, rate limiting and duplicate-callback
# suppression fall back to per-instance memory, which does not work across
# serverless instances — limits can be bypassed and callbacks double-processed.
#
# Adding the Vercel KV / Upstash integration sets KV_REST_API_* automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or point at Upstash directly instead:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Card / PayPal — export orders
# ---------------------------------------------------------------------------

# Once set, /api/checkout/card expects a real Stripe Checkout Session to be
# implemented in that route. Leave blank to keep the simulated flow.
STRIPE_SECRET_KEY=
